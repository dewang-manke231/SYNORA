# ==============================================================================
# Synora - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
# Required for JWT signing. Generate a unique value locally with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the generated value. Production must use a unique secret of at least 32 characters.
JWT_SECRET=replace-with-a-unique-random-value-at-least-32-characters
# Enable only for a public hackathon/demo deployment; production seed data is isolated and fictional.
DEMO_LOGIN_ENABLED=false
# Must also be enabled to provision the production sample workspace.
DEMO_SEED_ENABLED=false
# Public demo account provisioning (keep real values in backend environment only).
DEMO_MANAGER_EMAIL=manager@demo.synora.app
DEMO_MANAGER_PASSWORD=replace-with-public-demo-manager-password
DEMO_EMPLOYEE_EMAIL=employee@demo.synora.app
DEMO_EMPLOYEE_PASSWORD=replace-with-public-demo-employee-password
PROJECT_NAME="Synora - Knowledge Continuity & Project Protection Platform"
VERSION=0.1.0

# ------------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL / SQLite fallback)
# ------------------------------------------------------------------------------
# Production (Supabase PostgreSQL with pgvector extension):
# Format: postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Example:
# DATABASE_URL=postgresql+psycopg2://postgres:your_supabase_db_password@db.abcdefghijklmnopqrst.supabase.co:5432/postgres

# Local Zero-Setup Development Fallback:
DATABASE_URL=sqlite:///./synora.db

# ------------------------------------------------------------------------------
# Provider-Independent AI Configuration
# ------------------------------------------------------------------------------
# Provider: 'gemini', 'openai', or 'mock'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Embeddings: 'local' (sentence-transformers / MiniLM) or 'gemini'
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# CORS & Networking Configuration
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Public API URL (Used by React app in production)
VITE_API_URL=http://127.0.0.1:8000

